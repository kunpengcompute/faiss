+        dis[2] = vaddvq_f32(neon_res3);
+        dis[3] = vaddvq_f32(neon_res4);
+        dis[4] = vaddvq_f32(neon_res5);
+        dis[5] = vaddvq_f32(neon_res6);
+        dis[6] = vaddvq_f32(neon_res7);
+        dis[7] = vaddvq_f32(neon_res8);
