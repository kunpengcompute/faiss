+            uint8_t *quant_x = (uint8_t *)malloc(d * sizeof(uint8_t));
+            if (quant_x == NULL) {
+                printf("Error: FAILALLOC in krl_reorder_2_vector\n");
+                return FAILALLOC;
+            }
